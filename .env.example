# 複製此檔為 .env.local 並填入實際金鑰
# .env.local 已被 .gitignore 忽略，不會進版控

# Supabase（前端用，只有 read 權限）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase（scripts 用，service_role 有 write 權限）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# DeepL API（免費版 key 結尾為 :fx）
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# Anthropic Claude API（process.ts 摘要、digest.ts 每日報告）
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API（audio.ts 語音合成 TTS）
OPENAI_API_KEY=sk-...

# GitHub Token（選填，可提高 GitHub API rate limit）
GH_TOKEN=ghp_...
